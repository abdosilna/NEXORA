# ==========================================
# NEXORA BOT - Environment Configuration
# ==========================================
# Copy this file to .env and fill in values.
# NEVER commit .env or real secrets to Git.

# Server & Runtime
PORT=3000
NODE_ENV=development
BOT_NAME="NEXORA BOT"
LOG_LEVEL=info

# WhatsApp Multi-Device Pairing (International digits, e.g. 966501234567)
# Leave empty if running dashboard-only or before pairing.
WHATSAPP_NUMBER=
ADMIN_NUMBER=
WHATSAPP_AUTH_DIR=data/auth
WHATSAPP_AUTO_CONNECT=true

# Security & Admin Sessions
# Generate a strong random secret (at least 32 characters) in production.
APP_SECRET=
ADMIN_BOOTSTRAP_USERNAME=
ADMIN_BOOTSTRAP_PASSWORD=

# Database (SQLite persistent path; never store in /tmp)
DATABASE_PATH=data/nexora.sqlite

# AI Provider (gemini | openai | anthropic | disabled)
AI_PROVIDER=gemini
AI_API_KEY=
AI_MODEL=gemini-2.5-flash
AI_BASE_URL=
AI_TIMEOUT_MS=20000
AI_MAX_RETRIES=2
AI_DAILY_USER_BUDGET=40

# Independent Research Search Provider (wikipedia | duckduckgo | serper | brave | disabled)
SEARCH_PROVIDER=wikipedia
SEARCH_API_KEY=
RESEARCH_TIMEOUT_MS=10000

# Voice & Text-to-Speech Provider (disabled | openai | elevenlabs | google)
TTS_PROVIDER=disabled
TTS_API_KEY=
TTS_VOICE_ID=
TTS_MAX_CHARS=500
TTS_MAX_DURATION_SEC=45
TEMP_MEDIA_DIR=data/tmp-media
